<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_expense_tracker_return_wizard_form" model="ir.ui.view">
        <field name="name">expense.tracker.return.wizard.form</field>
        <field name="model">expense.tracker.return.wizard</field>
        <field name="arch" type="xml">
            <form string="Return for Correction">
                <field name="monthly_id" invisible="1"/>
                <group>
                    <field name="reason" placeholder="Explain what needs to be corrected..."/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Return Record"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

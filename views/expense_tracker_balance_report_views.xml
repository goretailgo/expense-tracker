<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_expense_tracker_balance_report_form" model="ir.ui.view">
        <field name="name">expense.tracker.balance.report.form</field>
        <field name="model">expense.tracker.balance.report</field>
        <field name="arch" type="xml">
            <form string="Category Balance Report" create="false" delete="false">
                <sheet>
                    <div class="oe_title">
                        <h1>Category Balance Report</h1>
                        <p class="text-muted mb-0">
                            Opening → Income → Expense → Closing, per income category.
                            Submitted records only.
                        </p>
                    </div>
                    <group>
                        <group>
                            <field name="year"/>
                            <field name="month" placeholder="All Months"/>
                            <field name="city_id" placeholder="All Cities" options="{'no_create': True}"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <field name="line_ids" nolabel="1">
                        <list create="0" edit="0" delete="0">
                            <field name="category_id" string="Account"/>
                            <field name="opening_balance" sum="Total"/>
                            <field name="income" sum="Total"/>
                            <field name="expense" sum="Total"/>
                            <field name="closing_balance" sum="Total"
                                   decoration-danger="closing_balance &lt; 0"
                                   decoration-success="closing_balance &gt;= 0"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_expense_tracker_balance_report" model="ir.actions.act_window">
        <field name="name">Report</field>
        <field name="res_model">expense.tracker.balance.report</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_expense_tracker_balance_report_form"/>
        <field name="target">current</field>
    </record>

</odoo>

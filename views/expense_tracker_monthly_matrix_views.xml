<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Director-only: Monthly Records list with income categories broken
         out as their own columns (dynamic - reads live from
         expense.tracker.category, so it never needs a code change when a
         category is added, renamed or archived). -->
    <record id="action_expense_tracker_monthly_matrix" model="ir.actions.client">
        <field name="name">Monthly Records (Category View)</field>
        <field name="tag">expense_tracker_monthly_matrix</field>
    </record>

    <menuitem id="menu_expense_tracker_monthly_matrix" name="Monthly Records (Category View)"
              parent="menu_expense_tracker_root"
              action="action_expense_tracker_monthly_matrix"
              groups="expense_tracker.group_expense_director"
              sequence="7"/>

</odoo>

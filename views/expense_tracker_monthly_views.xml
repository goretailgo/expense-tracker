<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================= Entry popup form (used for "Add Entry" and for
         opening an existing Income/Expense line to edit it). One shared
         form for both types - the Type field drives which categories are
         offered. ================= -->
    <record id="view_expense_tracker_line_form" model="ir.ui.view">
        <field name="name">expense.tracker.line.form</field>
        <field name="model">expense.tracker.line</field>
        <field name="arch" type="xml">
            <form string="Income / Expense Entry">
                <group>
                    <field name="line_type" widget="radio" options="{'horizontal': true}"/>
                    <field name="category_id" domain="[('type', '=', line_type)]" options="{'no_create': True}"/>
                    <field name="date"/>
                    <field name="description"/>
                    <field name="amount"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="monthly_id" invisible="1"/>
                </group>
            </form>
        </field>
    </record>

    <!-- ================= List ================= -->
    <record id="view_expense_tracker_monthly_list" model="ir.ui.view">
        <field name="name">expense.tracker.monthly.list</field>
        <field name="model">expense.tracker.monthly</field>
        <field name="arch" type="xml">
            <list string="Monthly Income &amp; Expense">
                <field name="city_id"/>
                <field name="manager_id"/>
                <field name="month"/>
                <field name="year" options="{'enable_formatting': false}"/>
                <field name="total_income" sum="Total"/>
                <field name="total_expense" sum="Total"/>
                <field name="net_income" sum="Total"/>
            </list>
        </field>
    </record>

    <!-- ================= Form ================= -->
    <record id="view_expense_tracker_monthly_form" model="ir.ui.view">
        <field name="name">expense.tracker.monthly.form</field>
        <field name="model">expense.tracker.monthly</field>
        <field name="arch" type="xml">
            <form string="Monthly Income &amp; Expense">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="city_id" options="{'no_create': True}"/>
                            <field name="month"/>
                            <field name="year" options="{'enable_formatting': false}"/>
                        </group>
                        <group>
                            <field name="manager_id" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="line_filter" widget="radio" options="{'horizontal': true}"/>
                    </group>
                    <field name="line_ids" nolabel="1" add-label="Add Entry"
                           domain="[('line_type', 'in', ['income', 'expense'] if line_filter == 'all' else [line_filter])]">
                        <list>
                            <field name="sequence" widget="handle"/>
                            <field name="date"/>
                            <field name="line_type" widget="badge"
                                   decoration-success="line_type == 'income'"
                                   decoration-danger="line_type == 'expense'"/>
                            <field name="category_id"/>
                            <field name="description"/>
                            <field name="amount" sum="Total"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                    <group class="oe_subtotal_footer oe_right">
                        <field name="total_income"/>
                        <field name="total_expense"/>
                        <field name="net_income" class="oe_subtotal_footer_separator"/>
                    </group>
                    <div class="oe_clear"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ================= Search ================= -->
    <record id="view_expense_tracker_monthly_search" model="ir.ui.view">
        <field name="name">expense.tracker.monthly.search</field>
        <field name="model">expense.tracker.monthly</field>
        <field name="arch" type="xml">
            <search string="Monthly Income &amp; Expense">
                <field name="city_id"/>
                <field name="manager_id"/>
                <field name="month"/>
                <field name="year"/>
                <field name="line_ids" string="Category"
                       filter_domain="[('line_ids.category_id.name','ilike',self)]"/>
                <separator/>
                <filter string="This Year" name="filter_this_year"
                        domain="[('year','=', context_today().year)]"/>
                <separator string="Group By"/>
                <group>
                    <filter string="Manager" name="groupby_manager" context="{'group_by':'manager_id'}"/>
                    <filter string="City" name="groupby_city" context="{'group_by':'city_id'}"/>
                    <filter string="Year" name="groupby_year" context="{'group_by':'year'}"/>
                    <filter string="Month" name="groupby_month" context="{'group_by':'month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ================= Pivot ================= -->
    <record id="view_expense_tracker_monthly_pivot" model="ir.ui.view">
        <field name="name">expense.tracker.monthly.pivot</field>
        <field name="model">expense.tracker.monthly</field>
        <field name="arch" type="xml">
            <pivot string="Income &amp; Expense Pivot">
                <field name="manager_id" type="row"/>
                <field name="city_id" type="row"/>
                <field name="month" type="col"/>
                <field name="total_income" type="measure"/>
                <field name="total_expense" type="measure"/>
                <field name="net_income" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- ================= Graph ================= -->
    <record id="view_expense_tracker_monthly_graph" model="ir.ui.view">
        <field name="name">expense.tracker.monthly.graph</field>
        <field name="model">expense.tracker.monthly</field>
        <field name="arch" type="xml">
            <graph string="Income &amp; Expense" type="bar">
                <field name="city_id" type="row"/>
                <field name="total_income" type="measure"/>
                <field name="total_expense" type="measure"/>
                <field name="net_income" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- ================= Action ================= -->
    <record id="action_expense_tracker_monthly" model="ir.actions.act_window">
        <field name="name">Monthly Income &amp; Expense</field>
        <field name="res_model">expense.tracker.monthly</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="search_view_id" ref="view_expense_tracker_monthly_search"/>
        <field name="context">{'search_default_filter_this_year': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create the first monthly record</p>
            <p>One record per City per Month. Add Income and Expense entries any
               time — nothing here is locked.</p>
        </field>
    </record>

</odoo>

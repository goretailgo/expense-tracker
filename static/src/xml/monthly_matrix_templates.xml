<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="expense_tracker.MonthlyMatrix" owl="1">
    <div class="o_expense_monthly_matrix">
      <div class="d-flex align-items-center p-3 border-bottom">
        <h4 class="mb-0">Monthly Income &amp; Expense — by Category</h4>
      </div>
      <div t-if="state.loading" class="p-4 text-muted">Loading…</div>
      <div t-else="" class="table-responsive p-3">
        <table class="table table-sm table-hover table-bordered o_expense_matrix_table">
          <thead class="table-light">
            <tr>
              <th>City</th>
              <th>Manager</th>
              <th>Month</th>
              <th class="text-end">Year</th>
              <t t-foreach="state.categories" t-as="cat" t-key="cat.id">
                <th class="text-end text-success"><t t-esc="cat.name"/></th>
              </t>
              <th class="text-end fw-bold">Total Income</th>
              <th class="text-end fw-bold">Total Expense</th>
              <th class="text-end fw-bold">Net Income</th>
            </tr>
          </thead>
          <tbody>
            <tr t-foreach="state.rows" t-as="row" t-key="row.id"
                class="o_expense_matrix_row" t-on-click="() => this.openRecord(row.id)">
              <td><t t-esc="row.city"/></td>
              <td><t t-esc="row.manager"/></td>
              <td><t t-esc="row.month"/></td>
              <td class="text-end"><t t-esc="row.year"/></td>
              <t t-foreach="row.cats" t-as="amt" t-key="amt_index">
                <td class="text-end"><t t-esc="amt"/></td>
              </t>
              <td class="text-end fw-bold"><t t-esc="row.total_income"/></td>
              <td class="text-end"><t t-esc="row.total_expense"/></td>
              <td class="text-end fw-bold"><t t-esc="row.net_income"/></td>
            </tr>
            <tr t-if="!state.rows.length">
              <td t-att-colspan="4 + state.categories.length + 3" class="text-center text-muted p-3">
                No monthly records found.
              </td>
            </tr>
          </tbody>
          <tfoot t-if="state.rows.length">
            <tr class="table-light fw-bold">
              <td colspan="4">Total</td>
              <t t-foreach="state.totals.cats" t-as="amt" t-key="amt_index">
                <td class="text-end"><t t-esc="amt"/></td>
              </t>
              <td class="text-end"><t t-esc="state.totals.total_income"/></td>
              <td class="text-end"><t t-esc="state.totals.total_expense"/></td>
              <td class="text-end"><t t-esc="state.totals.net_income"/></td>
            </tr>
          </tfoot>
        </table>
      </div>
    </div>
  </t>
</templates>

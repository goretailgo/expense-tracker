<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_expense_tracker_statement">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>
                            Income &amp; Expense Statement
                        </h2>
                        <div class="row mt32 mb32">
                            <div class="col-4">
                                <strong>City:</strong>
                                <p t-field="o.city_id.name"/>
                            </div>
                            <div class="col-4">
                                <strong>Month:</strong>
                                <p><span t-out="dict(o._fields['month'].selection).get(o.month)"/> <span t-field="o.year"/></p>
                            </div>
                            <div class="col-4">
                                <strong>Status:</strong>
                                <p t-field="o.state"/>
                            </div>
                        </div>

                        <h4>Income</h4>
                        <table class="table table-sm o_main_table">
                            <thead>
                                <tr>
                                    <th>Category</th>
                                    <th>Description</th>
                                    <th class="text-end">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.income_line_ids" t-as="line">
                                    <td t-field="line.category_id.name"/>
                                    <td t-field="line.description"/>
                                    <td class="text-end" t-field="line.amount"/>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="2"><strong>Total Income</strong></td>
                                    <td class="text-end"><strong t-field="o.total_income"/></td>
                                </tr>
                            </tfoot>
                        </table>

                        <h4>Expense</h4>
                        <table class="table table-sm o_main_table">
                            <thead>
                                <tr>
                                    <th>Category</th>
                                    <th>Description</th>
                                    <th class="text-end">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.expense_line_ids" t-as="line">
                                    <td t-field="line.category_id.name"/>
                                    <td t-field="line.description"/>
                                    <td class="text-end" t-field="line.amount"/>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="2"><strong>Total Expense</strong></td>
                                    <td class="text-end"><strong t-field="o.total_expense"/></td>
                                </tr>
                            </tfoot>
                        </table>

                        <table class="table table-sm mt32">
                            <tr>
                                <td><strong>Net Income (Income - Expense)</strong></td>
                                <td class="text-end"><strong t-field="o.net_income"/></td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
